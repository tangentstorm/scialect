{
  "name": "scialect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swarm orchestration for Lean formalization/informalization work, built on tangentswarm (tmux, agents, cloud sessions) via MCP.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "tsx --test test/*.test.mts",
    "setup:swarm": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "check:swarm": "tsx src/check-swarm.mts",
    "local-status": "tsx src/local-status.mts",
    "tell-worker": "tsx src/tell-worker.mts",
    "local-step": "tsx src/local-step.mts",
    "for-all": "tsx src/for-all.mts",
    "client": "tsx src/client.mts",
    "browse-sorries": "tsx src/browse-sorries.mts",
    "sync-assignees": "tsx src/sync-assignees.mts",
    "gh-status": "tsx src/gh-status.mts",
    "check-up-to-date": "bin/check-up-to-date",
    "check-rule-deps": "tsx src/check-rule-deps.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "kvm": "file:../platform/kvm"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
